{
  "name": "taskline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A compact task board used to practise integrating a feature branch before release.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "tsx src/server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/express": "4.17.21",
    "@types/node": "20.17.19",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "jsdom": "25.0.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite": "5.4.14",
    "vitest": "2.1.8"
  }
}
